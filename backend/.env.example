# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
NODE_ENV=development
PORT=5000
# Base URL of the Next.js frontend (used for CORS and links in emails/SMS).
FRONTEND_URL=http://localhost:3000
# Comma-separated list of additional origins allowed to call the API, if any.
ALLOWED_ORIGINS=

# --- MySQL database (managed via phpMyAdmin) ---
# Either set DATABASE_URL, or the discrete DB_* values below. DATABASE_URL wins if both are set.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/ministry_hub
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ministry_hub
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# --- Authentication (used once the users/auth module is implemented) ---
# Generate strong random values, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# --- Security ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Messaging providers (configured later, module by module) ---
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
